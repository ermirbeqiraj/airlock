#!/usr/bin/env bash
# airlock — run project code in throwaway containers built from bases we maintain.
#
#   airlock run <base> <command...>   run a command in a fresh container
#   airlock shell <base>              interactive shell in a fresh container
#   airlock build <base>              (re)build a base image
#   airlock status                    list base images and volumes
#   airlock prune                     remove volumes of projects that no longer exist
#
# Called through a shim symlink (node, npm, pnpm, uv, pip, … → this file), it runs that
# tool in the matching base: `pnpm test` == `airlock run node pnpm test`.
set -euo pipefail

AIRLOCK_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"  # bin/ -> repo root
BASES="$AIRLOCK_HOME/bases"

die() { echo "airlock: $*" >&2; exit 1; }

# Which base serves which tool.
base_for() {
  case "$1" in
    node|npm|npx|pnpm|pnpx) echo node ;;
    uv|uvx|pip|pip3)        echo python ;;
    *) return 1 ;;
  esac
}

# Per base: the file that marks a project, and the deps folder kept in a volume next to it.
deps_for() {
  case "$1" in
    node)   echo "package.json node_modules nm" ;;
    python) echo "pyproject.toml .venv venv" ;;
  esac
}

# Image tag = hash of the base's build files (+ common), so editing them triggers a rebuild.
image_for() {
  [ -f "$BASES/$1/Dockerfile" ] || die "unknown base '$1' (no $BASES/$1/Dockerfile)"
  local h
  h=$(cd "$BASES" && find "$1" common -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-12)
  echo "airlock-$1:$h"
}

# Build, then drop older tags of the same base.
build_image() {
  docker build -t "$1" -f "$BASES/$2/Dockerfile" "$BASES" >&2
  docker images "airlock-$2" --format '{{.Repository}}:{{.Tag}}' | grep -vx "$1" | xargs -r docker rmi >/dev/null 2>&1 || true
}

ensure_image() {
  local img; img=$(image_for "$1")
  if ! docker image inspect "$img" >/dev/null 2>&1; then
    echo "airlock: building $img (first use or base changed)" >&2
    build_image "$img" "$1"
  fi
  echo "$img"
}

# Named volume owned by the container user (new volumes start root-owned).
ensure_volume() {
  local vol=$1 img=$2 path=${3:-}
  docker volume inspect "$vol" >/dev/null 2>&1 && return 0
  docker volume create --label airlock=1 ${path:+--label "airlock.path=$path"} "$vol" >/dev/null
  docker run --rm -u 0 -v "$vol:/v" "$img" chown 1000:1000 /v
}

# Nearest directory with $1, from the current folder's real path (links resolved) up to $2.
find_up() {
  local d; d=$(pwd -P)
  while :; do
    [ -e "$d/$1" ] && { echo "$d"; return 0; }
    [ "$d" = "$2" ] || [ "$d" = / ] && return 1
    d=$(dirname "$d")
  done
}

port_busy() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

# Paths the host runs or reads later: agent, editor, CI and direnv config, and airlock's own.
# Package code must not plant or change them (docs/threat-model.md, C4).
# .git matches below the top level only (the top one is handled on its own): a nested .git
# file or folder makes host git run its hooks (found by red-team, tests/must-block/nested-git.sh).
PROTECTED=(.claude .mcp.json CLAUDE.md CLAUDE.local.md AGENTS.md .pi .vscode .idea .github
           .envrc .airlock .devcontainer .git)

# Protected paths under $1, relative, one per line. Skips .git (read-only anyway) and the deps
# volume mountpoint $2 (another filesystem: nothing can be moved into it).
protected_paths() {
  local root=$1 skip=${2:-} n expr=()
  for n in "${PROTECTED[@]}"; do expr+=(-o -name "$n"); done
  (cd "$root" && find . \( -path ./.git ${skip:+-o -path "./$skip"} \) -prune \
     -o \( "${expr[@]:1}" \) -print -prune) | sed 's|^\./||' | LC_ALL=C sort
}

# Fingerprint of one path: file content, symlink target, or a folder's whole contents.
fingerprint() {
  if [ -L "$1" ]; then echo "link:$(readlink "$1")"
  elif [ -d "$1" ]; then
    tar -C "$1" -cf - --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner . 2>/dev/null | sha256sum | cut -c1-16
  else sha256sum < "$1" | cut -c1-16; fi
}

snapshot() {  # <root> <paths...> -> "fingerprint path" lines
  local root=$1 p; shift
  for p in "$@"; do printf '%s %s\n' "$(fingerprint "$root/$p")" "$p"; done
}

# After a run. Existing protected paths were read-only (symlinks excepted: mounting them would
# expose their target), so a NEW protected path, or a changed symlink, means package code
# planted something. Then: move new ones to quarantine, and restore every changed existing one
# from the backup. That also undoes the rename trick (move the folder holding a read-only file
# away, plant a fresh one in its place). Changes without such evidence are the host's own edits
# during the run, and stay. Returns 1 if anything was planted.
check_planted() {
  local root=$1 skip=$2 before=$3 backup=$4 git_before=$5 p fp evidence=0
  local -a now new=() changed=()
  local -A was=()
  mapfile -t now < <(protected_paths "$root" "$skip")
  while read -r fp p; do if [ -n "$p" ]; then was[$p]=$fp; fi; done <<< "$before"
  for p in "${now[@]}"; do [ -n "${was[$p]+x}" ] || new+=("$p"); done
  # .git is skipped above (it's read-only when it exists), but one appearing during the run is
  # planted: host git would run its hooks, and a link would be mounted on the next run.
  if [ "$git_before" = 0 ] && { [ -e "$root/.git" ] || [ -L "$root/.git" ]; }; then new+=(.git); fi
  [ ${#new[@]} -gt 0 ] && evidence=1
  for p in "${!was[@]}"; do
    if [ -e "$root/$p" ] || [ -L "$root/$p" ]; then
      [ "$(fingerprint "$root/$p")" = "${was[$p]}" ] && continue
    fi
    changed+=("$p")
    [[ ${was[$p]} == link:* ]] && evidence=1
  done
  [ $evidence = 1 ] || return 0

  local q="${XDG_CACHE_HOME:-$HOME/.cache}/airlock/quarantine/$(date +%Y%m%d-%H%M%S)-$$"
  for p in "${new[@]}"; do mkdir -p "$q/$(dirname "$p")"; mv "$root/$p" "$q/$p"; done
  for p in "${changed[@]}"; do
    if [ -e "$root/$p" ] || [ -L "$root/$p" ]; then
      mkdir -p "$q/$(dirname "$p")"; mv "$root/$p" "$q/$p.replaced"
    fi
    mkdir -p "$(dirname "$root/$p")"; cp -a "$backup/$p" "$root/$p"
  done
  {
    echo "airlock: package code tried to plant files the host would run or read."
    echo "airlock: moved to quarantine: $q"
    [ ${#new[@]} -eq 0 ]     || printf 'airlock:   planted:  %s\n' "${new[@]}"
    [ ${#changed[@]} -eq 0 ] || printf 'airlock:   restored: %s\n' "${changed[@]}"
  } >&2
  return 1
}

cmd_run() {
  local base=$1; shift
  [ $# -gt 0 ] || die "usage: airlock run <base> <command...>"
  local img; img=$(ensure_image "$base")

  # What gets mounted: the git repo we're in, or the nearest folder marked with .airlock.
  # Never a plain folder: from ~/src or ~/Dropbox that would expose everything below (C5).
  local root
  if ! root=$(git rev-parse --show-toplevel 2>/dev/null); then
    root=$(find_up .airlock /) ||
      die "not in a project: run inside a git repo, or mark the project folder with an empty .airlock file."
  fi
  # Every check below runs on the real path: Docker follows links when it mounts, so a planted
  # `home -> $HOME` would otherwise pass as a project folder (red-team, tests/must-block/symlink-cwd.sh).
  root=$(readlink -f -- "$root")
  case "$HOME/" in
    "$root"/*) die "refusing to mount $root: it contains your home folder. Run from inside a project." ;;
  esac
  case "$root" in
    "$HOME"/*) ;;
    *) die "$root is outside $HOME, which is the only folder Docker Desktop shares with containers." ;;
  esac
  # Never mount what the host runs: airlock's own code (the shims run bin/airlock, bases/ get
  # built) or a folder on PATH. Package code could rewrite it (found by red-team,
  # tests/must-block/airlock-self.sh). An empty PATH entry means the current folder.
  local d dirs; IFS=: read -ra dirs <<< "$PATH"
  for d in "$AIRLOCK_HOME" "${dirs[@]}"; do
    d=$(readlink -f -- "${d:-.}") || continue
    case "$d/" in
      "$root"/*) die "refusing to mount $root: it contains $d, which the host runs (airlock itself or a folder on PATH)." ;;
    esac
  done

  local args=(
    --rm --init
    --user 1000:1000
    --cap-drop ALL --security-opt no-new-privileges
    --read-only
    --tmpfs /tmp:rw,exec,size=2g
    --tmpfs /home/dev:rw,exec,size=512m,uid=1000,gid=1000
    --memory 4g --pids-limit 1024
    -e "TZ=$(readlink -f /etc/localtime | sed 's|.*/zoneinfo/||')"
    -v "$root:$root" -w "$(pwd -P)"
  )
  # .git is mounted read-only (hooks and config run on the host). Never through a link: Docker
  # follows it, so a planted `.git -> $HOME` would mount the whole home folder (found by an
  # independent red-team run, tests/must-block/git-symlink.sh).
  [ -L "$root/.git" ] && die "$root/.git is a link, not a folder: refusing. Package code may have planted it to expose what it points to. Check it, and remove it if you didn't make it."
  local git_before=0
  if [ -e "$root/.git" ]; then git_before=1; args+=(-v "$root/.git:$root/.git:ro"); fi

  # Deps folder (node_modules, .venv) lives in a per-project volume, never on the host disk.
  local marker depdir tag pkg
  read -r marker depdir tag <<< "$(deps_for "$base")"
  if pkg=$(find_up "$marker" "$root"); then
    local vol="airlock-$tag-$(basename "$pkg")-$(printf %s "$pkg" | sha256sum | cut -c1-8)"
    ensure_volume "$vol" "$img" "$pkg"
    args+=(-v "$vol:$pkg/$depdir")
    [ "$base" = python ] && args+=(-e "VIRTUAL_ENV=$pkg/.venv")
  fi

  # Shared download cache across projects.
  ensure_volume airlock-cache "$img"
  args+=(-v airlock-cache:/cache)

  # Ports from <root>/.airlock (`ports=4321 3000`), host side bound to localhost only.
  # A port already in use is skipped: the dev server holding it is another airlock run.
  if [ -f "$root/.airlock" ]; then
    local p published=""
    for p in $(sed -n 's/^ports=//p' "$root/.airlock"); do
      [ "$p" -le 55535 ] 2>/dev/null || die "port '$p' in $root/.airlock: must be a number up to 55535"
      port_busy "$p" && continue
      args+=(-p "127.0.0.1:$p:$((p + 10000))")
      published+="$p "
    done
    args+=(-e "AIRLOCK_PORTS=$published")
    # `host_ports=5432`: the host's own services (e.g. compose Postgres) answer on localhost
    # inside, as the project's config expects. Adds no reach: host.docker.internal is open
    # anyway (N1).
    local hp=""
    for p in $(sed -n 's/^host_ports=//p' "$root/.airlock"); do
      [ "$p" -le 65535 ] 2>/dev/null || die "host port '$p' in $root/.airlock: must be a number up to 65535"
      hp+="$p "
    done
    args+=(-e "AIRLOCK_HOST_PORTS=$hp")
  fi

  # Protected paths (C4): back up, mount read-only, check again after the run.
  local skip="" rel
  if [ -n "${pkg:-}" ]; then rel=${pkg#"$root"}; rel=${rel#/}; skip="${rel:+$rel/}$depdir"; fi
  local -a existing; mapfile -t existing < <(protected_paths "$root" "$skip")
  local before backup p
  before=$(snapshot "$root" "${existing[@]}")
  backup=$(mktemp -d)
  for p in "${existing[@]}"; do
    (cd "$root" && cp -a --parents "$p" "$backup/")
    [ -L "$root/$p" ] || args+=(-v "$root/$p:$root/$p:ro")
  done

  # Not exec: the check runs after the container exits. Without a terminal, run docker in the
  # background so a TERM/INT to airlock can be passed on (bash defers traps while a foreground
  # child runs); 0<&0 keeps stdin, which background jobs would otherwise lose.
  local rc=0
  if [ -t 0 ] && [ -t 1 ]; then
    trap 'true' INT
    docker run -it "${args[@]}" "$img" "$@" || rc=$?
  else
    docker run -i "${args[@]}" "$img" "$@" 0<&0 &
    local dpid=$!
    trap "kill -TERM $dpid 2>/dev/null" INT TERM HUP
    while :; do
      wait "$dpid" && rc=0 || rc=$?
      kill -0 "$dpid" 2>/dev/null || break
    done
  fi
  trap - INT TERM HUP

  check_planted "$root" "$skip" "$before" "$backup" "$git_before" || { [ "$rc" -ne 0 ] || rc=1; }
  rm -rf "$backup"
  return "$rc"
}

cmd_status() {
  echo "== images"; docker images --filter 'reference=airlock-*' --format '{{.Repository}}:{{.Tag}}  {{.Size}}  {{.CreatedSince}}'
  echo "== volumes"; docker volume ls --filter label=airlock=1 --format '{{.Name}}  {{.Label "airlock.path"}}'
}

# Remove deps volumes whose project folder no longer exists.
cmd_prune() {
  local vol path
  docker volume ls -q --filter label=airlock.path | while read -r vol; do
    path=$(docker volume inspect -f '{{index .Labels "airlock.path"}}' "$vol")
    [ -d "$path" ] || { docker volume rm "$vol" >/dev/null && echo "removed $vol ($path)"; }
  done
}

# Shim mode: invoked as node/npm/pnpm/uv/pip/….
me=$(basename "$0")
if [ "$me" != airlock ]; then
  case "$me" in
    pip|pip3) die "pip is disabled here: it has no 7-day rule and builds local source packages. Use 'uv pip $*' (same commands)." ;;
  esac
  base=$(base_for "$me") || die "no base for '$me'"
  rc=0; cmd_run "$base" "$me" "$@" || rc=$?
  exit "$rc"
fi

case "${1:-}" in
  run)    shift; [ $# -ge 1 ] || die "usage: airlock run <base> <command...>"
          rc=0; cmd_run "$@" || rc=$?; exit "$rc" ;;
  shell)  shift; [ $# -ge 1 ] || die "usage: airlock shell <base>"; cmd_run "$1" bash ;;
  build)  shift; [ $# -ge 1 ] || die "usage: airlock build <base>"; build_image "$(image_for "$1")" "$1" ;;
  status) cmd_status ;;
  prune)  cmd_prune ;;
  *)      sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
